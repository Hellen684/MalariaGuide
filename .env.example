# Malaria Guide Environment Variables Template
# Copy this file to '.env' and fill in your local config settings

# API Server Configuration
PORT=5000

# Database Configuration (PostgreSQL connection URL format)
# Syntax: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/malaria_guide

# Security Configurations
JWT_SECRET=default_local_dev_token_generation_secret_xyz123
